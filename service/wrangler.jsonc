{
  "name": "echo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "echo",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      // Local development (wrangler dev --local, tests, e2e) keeps its own storage under this id.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  // Workers Logs: keeps console.error output (unexpected errors, failed cron work) where the owner can read it.
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_URL": "https://echo.example.workers.dev",
    "GITHUB_API_URL": "https://api.github.com"
  },
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
